# Copy to .env and fill in once you have a merchant-generated Clover API token.
# Leave unset to run in "not configured" mode (no data available).
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=

# us | eu | la | sandbox
CLOVER_REGION=us

CLOVER_DB_PATH=./clover_data.sqlite3
CLOVER_LOOKBACK_MONTHS=15

# Optional: overrides CLOVER_REGION's base URL. Point this at the local fake
# server (dev/fake_clover_server.py) to test the full backfill/sync flow
# without a real Clover account, e.g. http://127.0.0.1:8765
CLOVER_BASE_URL=
